{
  "name": "@weave/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm run prisma:generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "test": "vitest run",
    "test:db": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "typecheck": "pnpm prisma:generate && pnpm --filter @weave/types build && pnpm --filter @weave/utils build && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "^11.4.6",
    "@weave/types": "workspace:*",
    "@weave/utils": "workspace:*",
    "@prisma/client": "^6.19.0",
    "@simplewebauthn/server": "^13.3.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.6.1",
    "otpauth": "^9.5.1",
    "prisma": "^6.19.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "dotenv-cli": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  }
}

    "@weave/utils": "workspace:*",
    "@pinia/nuxt": "catalog:",
    "@tanstack/vue-query": "^5.101.4",
    "@tanstack/vue-virtual": "^3.13.32",
    "@vueuse/core": "^13.9.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.6.1",
    "monaco-editor": "^0.56.0",
    "nuxt": "catalog:",
    "pinia": "catalog:",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.5",
    "vitest": "4.1.10",
    "vue": "3.5.40"

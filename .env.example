# Local development configuration. Replace all passwords and secrets before production use.
NODE_ENV=development
PORT=6770
NUXT_PORT=6771

# Browser frontend and public API origins.
APP_ORIGIN=http://localhost:6771
API_ORIGIN=http://localhost:6770

# Docker Compose host ports.
BACKEND_PORT=6770
FRONTEND_PORT=6771

# PostgreSQL
POSTGRES_DB=orz_people
POSTGRES_USER=orz_people
POSTGRES_PASSWORD=development-only-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=development-only-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/0

# Authentication. Production requires distinct, securely generated values.
JWT_SECRET=development-only-change-me-jwt-secret
JWT_ISSUER=weave
JWT_AUDIENCE=weave-api
JWT_ACCESS_TTL_SECONDS=900
AUTH_HMAC_SECRET=development-only-change-me-hmac-secret
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=600
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
TOTP_ENCRYPTION_KEY=development-only-change-me-totp-key
TOTP_PERIOD_SECONDS=30

# Optional first system administrator. Set all five values for the first production
# start only; remove all five values after the account has been created.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_NAME=System Administrator
# BOOTSTRAP_ADMIN_NICKNAME=Admin
# BOOTSTRAP_ADMIN_PASSWORD=use-a-strong-secret

# Passkeys. Production origins must use HTTPS.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Orz People Platform
WEBAUTHN_ORIGINS=http://localhost:6771

# Application limits and current single-workspace setting.
FORM_SUBMISSION_RATE_LIMIT=30
FORM_SUBMISSION_RATE_WINDOW_SECONDS=60
DEFAULT_WORKSPACE_ID=1
